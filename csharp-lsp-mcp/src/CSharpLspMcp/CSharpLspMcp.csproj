<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CSharpLspMcp</RootNamespace>
    <AssemblyName>csharp-lsp-mcp</AssemblyName>

    <!-- NuGet Package Properties -->
    <PackageId>CSharpLspMcp</PackageId>
    <Version>1.1.0</Version>
    <Authors>BorisShteynberg</Authors>
    <Company>BorisShteynberg</Company>
    <Product>csharp-lsp-mcp</Product>
    <Description>MCP (Model Context Protocol) server providing C#, Razor, and XAML language intelligence for AI assistants like Claude. Exposes IntelliSense, diagnostics, go-to-definition, and code analysis through the standardized MCP protocol.</Description>
    <PackageTags>mcp;csharp;dotnet;language-server;claude;ai;xaml;razor;intellisense;roslyn;model-context-protocol</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/BorisShteynberg/csharp-lsp-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BorisShteynberg/csharp-lsp-mcp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>csharp-lsp-mcp</ToolCommandName>

    <!-- Source Link for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="StreamJsonRpc" Version="2.24.92" />
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

